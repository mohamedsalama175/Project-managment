# ==============================================================================
# DeliverOps Enterprise Platform - Hardened Production Environment Template
# ==============================================================================

# --- Application Core (Production Hardened) ---
APP_NAME="DeliverOps Enterprise"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.deliverops.com
APP_TIMEZONE=UTC
APP_LOCALE=en

# --- Frontend, Sanctum & Strict CORS ---
FRONTEND_URL=https://app.deliverops.com
SANCTUM_STATEFUL_DOMAINS=app.deliverops.com

# --- Initial Super-Admin Bootstrap ---
# MANDATORY: Generate a cryptographically secure 16+ character password before running deliverops:install
INITIAL_ADMIN_NAME="DeliverOps System Administrator"
INITIAL_ADMIN_EMAIL="security-admin@deliverops.com"
INITIAL_ADMIN_PASSWORD="CHANGE_ME_TO_A_SECURE_RANDOM_SECRET_BEFORE_INSTALL"

# --- Security & Crypto ---
BCRYPT_ROUNDS=12
LOG_CHANNEL=daily
LOG_LEVEL=error

# --- Primary Database (MySQL 8.0 InnoDB Production Cluster) ---
DB_CONNECTION=mysql
DB_HOST=mysql.internal.deliverops.net
DB_PORT=3306
DB_DATABASE=deliverops_production
DB_USERNAME=deliverops_app
DB_PASSWORD="SECURE_PRODUCTION_DB_PASSWORD"

# --- Stateful HttpOnly Cookie Hardening ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=.deliverops.com
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Production Cache, Queue & Redis Cluster ---
CACHE_STORE=redis
QUEUE_CONNECTION=redis
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3

REDIS_CLIENT=phpredis
REDIS_HOST=redis.internal.deliverops.net
REDIS_PASSWORD="SECURE_PRODUCTION_REDIS_PASSWORD"
REDIS_PORT=6379

# --- Production Mail Transport (AWS SES / Postmark / Sendgrid) ---
MAIL_MAILER=smtp
MAIL_HOST=email-smtp.us-east-1.amazonaws.com
MAIL_PORT=587
MAIL_USERNAME=SES_SMTP_USERNAME
MAIL_PASSWORD=SES_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@deliverops.com"
MAIL_FROM_NAME="DeliverOps Governance"

# --- Production Rate Limiting ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_MFA_CHALLENGE_MAX=5
RATE_LIMIT_GUEST_REGISTER_MAX=5
