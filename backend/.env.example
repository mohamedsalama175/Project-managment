# ==============================================================================
# DeliverOps Enterprise Platform - Development Environment Configuration
# ==============================================================================

# --- Application Core ---
APP_NAME="DeliverOps Enterprise"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC
APP_LOCALE=en
APP_REGION=EMEA

# --- Frontend & CORS Settings ---
FRONTEND_URL=http://localhost:5173
SANCTUM_STATEFUL_DOMAINS=localhost:5173,127.0.0.1:5173,localhost:8000,127.0.0.1:8000

# --- Initial Super-Admin Bootstrap (Consumed by deliverops:install) ---
INITIAL_ADMIN_NAME="DeliverOps Super Admin"
INITIAL_ADMIN_EMAIL="admin@deliverops.com"
INITIAL_ADMIN_PASSWORD="AdminPassword2026!"

# --- Security & Crypto ---
BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=debug

# --- Primary Database (MySQL 8.0 InnoDB or SQLite :memory: for dev/test) ---
DB_CONNECTION=sqlite
# DB_CONNECTION=mysql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=deliverops
# DB_USERNAME=root
# DB_PASSWORD=

# --- Session & Stateful Cookie Configuration ---
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

# --- Cache, Queue & Redis ---
CACHE_STORE=database
QUEUE_CONNECTION=database
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# --- Mail Configuration ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@deliverops.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Rate Limiting Thresholds ---
RATE_LIMIT_LOGIN_MAX=5
RATE_LIMIT_MFA_CHALLENGE_MAX=5
RATE_LIMIT_GUEST_REGISTER_MAX=10
